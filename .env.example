# AgriGuard Environment Configuration
# Copy this file to .env and fill in your keys. DO NOT COMMIT .env TO VERSION CONTROL.

# -------------------------
# Dataset APIs
# -------------------------
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

ROBOFLOW_API_KEY=your_roboflow_api_key

# -------------------------
# Backend Server
# -------------------------
HOST=0.0.0.0
PORT=8000
DEBUG=True

# -------------------------
# Logging
# -------------------------
LOG_LEVEL=INFO
